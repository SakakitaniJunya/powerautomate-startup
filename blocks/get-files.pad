#! param Folder
#! param Into
#! param Filter default="*.csv"
# フォルダ内ファイル一覧を取得 (サブフォルダなし・ソートなし)
Folder.GetFiles Folder: {{Folder}} FileFilter: $'''{{Filter}}''' IncludeSubfolders: False FailOnAccessDenied: True SortBy1: Folder.SortBy.NoSort SortDescending1: False SortBy2: Folder.SortBy.NoSort SortDescending2: False SortBy3: Folder.SortBy.NoSort SortDescending3: False Files=> {{Into}}
