# ============================================================
# 17 - 部署別 Excel の異常検出 → 部署部長へメール通知
# ------------------------------------------------------------
# 部署ごとに Excel の列名・様式が違う前提のバッチ。
# 部署プロファイル JSON (--dept) に列対応・異常ルール・部長の
# メールアドレスをまとめ、fincalc.exe が部署フォーマットで
# 読み取り → 異常行があれば Outlook 経由で部長へ送信する。
#
#   Main           = 司令塔 (呼び出しと分岐のみ)
#   RunDeptBatch   = fincalc.exe excel dep-batch --dept → Batch
#   SendManagerEmail = 部長宛に異常サマリを Outlook 送信 + 監査ログ
#   LogClean       = 異常ゼロの正常終了をログ + ダイアログ
#   LogCliError    = exe 失敗をログ + 警告ダイアログ
#
# 部署プロファイルの例: columns/dept-a.example.json
#   { "code","name","managerEmail","columns":{...},"anomaly":{...} }
#
# CLI JSON 出力 (PAD 側で参照するキー):
#   department, managerEmail, okCount, errorCount,
#   anomalyCount, anomalies[{sheet,row,asset,field,value,reason}]
#
# 注意:
#   - Outlook デスクトップのセットアップ済みアカウントが必要
#   - Account には送信に使う Outlook アカウント名(メールアドレス)を入れる
#     (空にできないため MailAccount をプロファイルで必須化)
#   - 検証時は SendEmail の IsDraft を True にすると下書き保存になる
#   - SendTo は宛先リスト型。[変数] 形式で渡す (% を付けると貼り付け拒否)
# ============================================================
#! requires: ExePath WorkDir DeptProfilePath InputXlsx OutputXlsx LogPath MailAccount

SET JobName TO $'''部署別資産台帳チェック'''

CALL RunDeptBatch
IF CliExit = 0 THEN
    IF Batch.anomalyCount > 0 THEN
        CALL SendManagerEmail
    ELSE
        CALL LogClean
    END
ELSE
    CALL LogCliError
END

#! subflow RunDeptBatch
# --dept で部署プロファイル (列対応+異常ルール+部長メール) を適用
{{> run-cli Args="excel dep-batch --dept \"%DeptProfilePath%\" --input \"%InputXlsx%\" --sheet \"*\" --output \"%OutputXlsx%\""}}
IF CliExit = 0 THEN
    {{> json-parse Into="Batch"}}
END

#! subflow SendManagerEmail
# 異常あり: 部署プロファイルの managerEmail 宛に Outlook で送信
DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
IF Batch.managerEmail = '' THEN
    {{> append-log Path="LogPath" Text="%Now% [WARN] %Batch.department% 異常%Batch.anomalyCount%件だが部長メール未設定"}}
    {{> warn-dialog Title="宛先なし" Message="$'''%Batch.department% で異常 %Batch.anomalyCount% 件。プロファイルの managerEmail を設定してください'''" Timeout="30"}}
ELSE
    SET MailBody TO $'''%Batch.department% の資産台帳で異常を検出しました。

異常件数: %Batch.anomalyCount% 件 (うちパースエラー %Batch.errorCount% 行)
先頭の異常: 行 %Batch.anomalies[0].row% / %Batch.anomalies[0].asset% / %Batch.anomalies[0].reason%

詳細は結果ワークブックの anomalies シートと summary シートの error 列を確認してください。
時刻: %Now%'''
    Outlook.Launch.Launch Instance=> OutlookInstance
    # SendTo は宛先リスト型。% は付けず [変数] で渡す (複数宛先はカンマ区切り)
    Outlook.SendEmailThroughOutlook.SendEmail Instance: OutlookInstance Account: MailAccount SendTo: [Batch.managerEmail] Subject: $'''[要確認] %Batch.department% 資産台帳: 異常 %Batch.anomalyCount% 件''' Body: MailBody IsBodyHtml: False IsDraft: False
    {{> append-log Path="LogPath" Text="%Now% [MAIL] %Batch.department% → %Batch.managerEmail% 異常%Batch.anomalyCount%件を通知"}}
    Outlook.Close.Close Instance: OutlookInstance
END

#! subflow LogClean
DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
{{> append-log Path="LogPath" Text="%Now% [OK] %Batch.department% 異常なし (%Batch.okCount% 件処理)"}}
{{> info-dialog Title="異常なし" Message="$'''%Batch.department%: %Batch.okCount% 件処理、異常はありません'''" Timeout="30"}}

#! subflow LogCliError
DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> Now
{{> append-log Path="LogPath" Text="%Now% [ERROR] %JobName% exit=%CliExit% stderr=%CliErr%"}}
{{> warn-dialog Title="バッチ失敗" Message="$'''fincalc.exe が失敗 (exit=%CliExit%)。ログを確認してください'''" Timeout="30"}}
